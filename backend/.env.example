# --- Backend app settings (backend/core/config.py) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_crypto_advisor
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:5173

# --- Auth (backend/core/config.py) ---
# SECRET_KEY has no default and is required - generate a long random value,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`. Never reuse
# this placeholder in a real deployment.
SECRET_KEY=change-me-to-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
